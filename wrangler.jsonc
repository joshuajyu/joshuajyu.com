// Cloudflare Worker config — static assets only (no `main` script).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the dashboard for Workers Builds.
  "name": "joshuajyu-com",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Required (even empty) for `wrangler preview`, the non-production deploy
  // command in Workers Builds. Assets/compat settings stay at the top level.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {}
  // Open (see README): the production workers.dev URL is public. Option:
  // "workers_dev": false + "preview_urls": true — test previews still work.
}
