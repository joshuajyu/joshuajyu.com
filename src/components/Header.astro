---
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";

const links = [
  { href: "#work", label: "Work" },
  { href: "#contact", label: "Contact" },
];
---

<header
  class="site-header sticky top-0 z-40 border-b border-border bg-bg/80 backdrop-blur supports-[backdrop-filter]:bg-bg/70"
>
  <nav
    class="mx-auto flex h-16 max-w-3xl items-center justify-between px-6"
    aria-label="Primary"
  >
    <a href="#intro" class="text-2xl" aria-label="joshuajyu — back to top">
      <Wordmark />
    </a>
    <div class="flex items-center gap-1 sm:gap-3">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="rounded-full px-3 py-1.5 text-sm text-muted transition-colors hover:bg-subtle hover:text-fg"
          >
            {l.label}
          </a>
        ))
      }
      <ThemeToggle />
    </div>
  </nav>
</header>
