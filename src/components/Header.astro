---
import Stepper from "./Stepper.astro";
import ThemeToggle from "./ThemeToggle.astro";
import Wordmark from "./Wordmark.astro";
---

<!--
  ≥ lg: fixed left rail — wordmark, section stepper, theme toggle.
  < lg: wordmark + toggle sit at the top of the first page and scroll away
  with it; no stepper.
-->
<header
  class="absolute inset-x-0 top-0 z-40 flex h-16 items-center justify-between px-6 lg:fixed lg:inset-y-0 lg:right-auto lg:h-auto lg:w-52 lg:flex-col lg:items-start lg:border-r lg:border-border lg:px-8 lg:py-10"
>
  <a href="#intro" class="text-2xl" aria-label="joshuajyu — back to top">
    <Wordmark />
  </a>
  <div class="hidden lg:block">
    <Stepper />
  </div>
  <div class="lg:-ml-2">
    <ThemeToggle />
  </div>
</header>
