---
// "…and I hope you have a [nice] [day]!" — the adjective sits on a small
// slot-machine reel set into the line: an 8-sided, flat-shaded 3D drum in the
// accent colour. It rolls on arrival; click / tap / Enter rolls it again. The time word follows the viewer's local clock. Behaviour lives
// in src/scripts/greeting.ts (styles: "Greeting slot reel" in global.css).
// Without JavaScript the reel simply shows "nice".
import { adjectives } from "../data/greeting";
const FACES = 8;
---

I hope you have a <button
  type="button"
  class="slot"
  data-slot
  aria-label="nice — spin for another adjective"
  title="Spin again"
  ><span class="slot-sizer" aria-hidden="true">{adjectives.map((w) => <span>{w}</span>)}</span><span class="reel" aria-hidden="true"
    ><span class="reel-drum"
      >{
        Array.from({ length: FACES }, (_, i) => (
          <span class="reel-face" style={`--i: ${i}`}>
            {i === 0 ? "nice" : ""}
          </span>
        ))
      }</span
    ></span
  ><svg
    class="slot-hint"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"></path><path d="M21 3v5h-5"></path></svg
  ></button
> <span data-daypart>day</span>!

<script>
  import "../scripts/greeting";
</script>
