---
// Light/dark toggle. Defaults to the system theme; the initial class is set by
// the inline script in Base.astro. Choosing the theme that matches the system
// clears the saved preference so the page follows the system again.
---

<button
  type="button"
  id="theme-toggle"
  class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-subtle hover:text-fg"
  aria-label="Toggle dark mode"
  aria-pressed="false"
>
  <!-- sun: shown in dark mode -->
  <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <!-- moon: shown in light mode -->
  <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById("theme-toggle")!;
  const system = matchMedia("(prefers-color-scheme: dark)");

  const sync = () => button.setAttribute("aria-pressed", String(root.classList.contains("dark")));

  const apply = (dark: boolean) => {
    root.classList.add("theme-switching");
    root.classList.toggle("dark", dark);
    sync();
    // Re-enable transitions after the new colours have painted.
    requestAnimationFrame(() =>
      requestAnimationFrame(() => root.classList.remove("theme-switching")),
    );
  };

  const stored = () => {
    try {
      return localStorage.getItem("theme");
    } catch {
      return null;
    }
  };

  button.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    try {
      if (dark === system.matches) localStorage.removeItem("theme");
      else localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
    apply(dark);
  });

  // Follow the OS setting live unless the visitor has picked a theme.
  system.addEventListener("change", (e) => {
    if (!stored()) apply(e.matches);
  });

  sync();
</script>
