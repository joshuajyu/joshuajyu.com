---
// Appearance menu: a floating paintbrush button that opens a small glass
// panel (native popover: light-dismiss, Esc to close, top layer) with
//   • Theme — light / dark, shown side by side (sun / moon). Defaults to the
//     system theme; choosing the one that matches the system clears the saved
//     preference so the page follows the system again.
//   • Dynamic background — switches the lava on/off. Off adds `no-lava` to
//     <html>: the layer is hidden and the renderer stops its loop.
// Both are saved in localStorage ("theme", "lava") and applied before first
// paint by the inline script in Base.astro, so neither flashes on reload.
// Icons: Lucide (ISC License, Copyright (c) Lucide Icons and Contributors).
---

<div class="glass fixed top-3.5 right-5 z-50 rounded-full border border-border shadow-sm lg:top-10 lg:right-8">
  <button
    type="button"
    popovertarget="appearance-panel"
    class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-subtle hover:text-fg"
    aria-label="Appearance settings"
  >
    <svg class="size-[1.15rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m14.622 17.897-10.68-2.913"></path>
      <path d="M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z"></path>
      <path d="M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15"></path>
    </svg>
  </button>
</div>

<div
  id="appearance-panel"
  popover
  role="group"
  aria-labelledby="appearance-title"
  class="glass fixed inset-auto top-[3.75rem] right-5 m-0 w-64 rounded-2xl border border-border p-4 text-sm text-fg shadow-lg lg:top-[5.375rem] lg:right-8"
>
  <p id="appearance-title" class="mb-3 text-xs font-medium tracking-wide text-muted uppercase">Appearance</p>

  <div class="flex items-center justify-between gap-3">
    <span id="theme-label">Theme</span>
    <div role="group" aria-labelledby="theme-label" class="flex gap-0.5 rounded-full border border-border bg-subtle/70 p-0.5">
      <button
        type="button"
        data-theme-choice="light"
        aria-pressed="false"
        aria-label="Light"
        class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:text-fg aria-pressed:bg-card aria-pressed:text-fg aria-pressed:shadow-sm"
      >
        <svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2m-7.07-17.07 1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
      <button
        type="button"
        data-theme-choice="dark"
        aria-pressed="false"
        aria-label="Dark"
        class="grid size-8 place-items-center rounded-full text-muted transition-colors hover:text-fg aria-pressed:bg-card aria-pressed:text-fg aria-pressed:shadow-sm"
      >
        <svg class="size-[1.05rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="mt-3 flex items-center justify-between gap-3">
    <span id="lava-label">Dynamic background</span>
    <button
      type="button"
      id="lava-switch"
      role="switch"
      aria-checked="true"
      aria-labelledby="lava-label"
      class="group relative h-6 w-10 shrink-0 rounded-full bg-muted/35 transition-colors aria-checked:bg-accent"
    >
      <span
        class="absolute top-0.5 left-0.5 size-5 rounded-full bg-card shadow-sm transition-transform group-aria-checked:translate-x-4"
        aria-hidden="true"
      ></span>
    </button>
  </div>
</div>

<script>
  const root = document.documentElement;
  const system = matchMedia("(prefers-color-scheme: dark)");
  const themeButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-theme-choice]")];
  const lavaSwitch = document.getElementById("lava-switch")!;

  const store = {
    get: (key: string) => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    },
    set: (key: string, value: string | null) => {
      try {
        if (value === null) localStorage.removeItem(key);
        else localStorage.setItem(key, value);
      } catch {}
    },
  };

  // --- theme ---
  const syncTheme = () => {
    const dark = root.classList.contains("dark");
    for (const b of themeButtons) b.setAttribute("aria-pressed", String((b.dataset.themeChoice === "dark") === dark));
  };

  const applyTheme = (dark: boolean) => {
    root.classList.add("theme-switching");
    root.classList.toggle("dark", dark);
    syncTheme();
    // Re-enable transitions after the new colours have painted.
    requestAnimationFrame(() => requestAnimationFrame(() => root.classList.remove("theme-switching")));
  };

  for (const b of themeButtons) {
    b.addEventListener("click", () => {
      const dark = b.dataset.themeChoice === "dark";
      store.set("theme", dark === system.matches ? null : b.dataset.themeChoice!);
      applyTheme(dark);
    });
  }

  // Follow the OS setting live unless the visitor has picked a theme.
  system.addEventListener("change", (e) => {
    if (!store.get("theme")) applyTheme(e.matches);
  });

  // --- dynamic background ---
  const syncLava = () => lavaSwitch.setAttribute("aria-checked", String(!root.classList.contains("no-lava")));

  lavaSwitch.addEventListener("click", () => {
    const turnOn = root.classList.contains("no-lava");
    root.classList.toggle("no-lava", !turnOn);
    store.set("lava", turnOn ? null : "off");
    syncLava();
  });

  syncTheme();
  syncLava();
</script>
